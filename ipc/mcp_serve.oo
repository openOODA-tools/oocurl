// # MCP Stdio Server - HTTP API Request and Inspection Engine
//
// Logline: Speaks Model Context Protocol over stdio for LLM HTTP and API client requests.
//
// Setup: Requires &TcpCap and &FsReadCap. Zero ambient authority.
//
// Beats:
//   1. Handle initialize, ping, tools/list, shutdown, and notification lifecycle handshakes.
//   2. Dispatch tools/call invocations and handle argument validation.
//   3. Manage streaming object-boundary lexer framing over stdio.

import "json_field.oo";
import "tool_dispatch.oo";

pub fn handle_mcp_request(tcp: &TcpCap, req: String) -> String {
    let method: String = json_field_string(req, "method");
    let raw_id: String = json_field_raw(req, "id");
    let jsonrpc: String = json_field_string(req, "jsonrpc");
    if jsonrpc != "" && jsonrpc != "2.0" {
        return build_error(raw_id, -32600, "invalid jsonrpc version");
    }

    if chars_len(raw_id) == 0 {
        if method == "exit" || method == "notifications/initialized" {
            return "";
        }
        if chars_len(method) == 0 {
            return build_error("", -32600, "invalid request");
        }
        return "";
    }
    let id: String = raw_id;

    if chars_len(method) == 0 {
        return build_error(id, -32600, "invalid request");
    }

    if method == "initialize" {
        return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"oocurl\",\"version\":\"0.2.0\"}}}";
    }
    if method == "notifications/initialized" || method == "exit" {
        return "";
    }
    if method == "ping" {
        return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{}}";
    }
    if method == "tools/list" {
        return tools_list_payload(id);
    }
    if method == "tools/call" {
        return handle_tool_call(tcp, id, req);
    }
    if method == "shutdown" {
        return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":null}";
    }
    return build_error(id, -32601, "method not found: " + method);
}

pub fn run_mcp_server(tcp: &TcpCap, fs: &FsReadCap) -> Int {
    let mut buf: String = "";
    let mut running: Bool = true;
    while running {
        let r: Result[String, String] = oo_read_stdin_chunk(fs, 100);
        let eof: Bool = !r.is_ok();
        if !eof {
            let chunk: String = match r { Ok(s) => s, Err(_) => "" };
            if chars_len(chunk) > 0 {
                buf = buf + chunk;
            }
        }

        let mut consuming: Bool = true;
        while consuming {
            let n: Int = chars_len(buf);
            let start: Int = skip_whitespace(buf, 0);
            if start >= n {
                buf = "";
                consuming = false;
            } else {
                let c0: String = char_at(buf, start);
                if c0 == "{" {
                    let end: Int = scan_json_object_end(buf, start);
                    if end > start {
                        let msg: String = str_slice(buf, start, end);
                        buf = str_slice(buf, end, chars_len(buf));
                        let method: String = json_field_string(msg, "method");
                        if method == "exit" {
                            running = false;
                            consuming = false;
                            break;
                        }
                        let reply: String = handle_mcp_request(tcp, msg);
                        if chars_len(reply) > 0 {
                            println(reply);
                        }
                    } else {
                        if eof {
                            println(build_error("", -32600, "parse error: incomplete json"));
                            buf = "";
                        }
                        consuming = false;
                    }
                } else {
                    let nl_pos: Int = str_index_of(buf, "\n");
                    if nl_pos >= 0 {
                        let junk: String = str_slice(buf, start, nl_pos);
                        buf = str_slice(buf, nl_pos + 1, chars_len(buf));
                        let tr: String = str_trim(junk);
                        if tr == "exit" {
                            running = false;
                            consuming = false;
                            break;
                        }
                        if chars_len(tr) > 0 {
                            println(build_error("", -32600, "invalid request"));
                        }
                    } else {
                        if eof {
                            let tr: String = str_trim(str_slice(buf, start, chars_len(buf)));
                            if tr == "exit" {
                                running = false;
                                consuming = false;
                                break;
                            }
                            if chars_len(tr) > 0 {
                                println(build_error("", -32600, "invalid request"));
                            }
                            buf = "";
                        }
                        consuming = false;
                    }
                }
            }
        }

        if eof {
            running = false;
        }
    }
    return 0;
}
