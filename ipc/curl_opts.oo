// # HTTP CLI Options Parser
//
// Logline: Decodes command line arguments into operational modes for oocurl.
//
// Setup: Pure value type and parser. Zero ambient authority.
//
// Beats:
//   1. Define CurlOpts struct holding URL, method, headers, payload, and output options.
//   2. Provide safe default initializer.
//   3. Parse argument vector into validated CurlOpts model.

pub type CurlOpts = struct {
    url: String,
    method: String,
    headers: List[String],
    data: String,
    include_headers: Bool,
    head_only: Bool,
    no_color: Bool,
    silent: Bool,
    output_file: String,
    mcp_mode: Bool,
    help_mode: Bool,
    version_mode: Bool,
    error_msg: String
};

pub fn curl_opts_default() -> CurlOpts {
    return CurlOpts {
        url: "",
        method: "GET",
        headers: list_new(),
        data: "",
        include_headers: false,
        head_only: false,
        no_color: false,
        silent: false,
        output_file: "",
        mcp_mode: false,
        help_mode: false,
        version_mode: false,
        error_msg: ""
    };
}

pub fn str_to_upper(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let b: Int = byte_at(s, i);
        if b >= 97 && b <= 122 {
            out = out + bytes_to_str(bytes_push(bytes_new(), b - 32));
        } else {
            out = out + char_at(s, i);
        }
        i = i + 1;
    }
    return out;
}

pub fn parse_curl_args(args: List[String]) -> CurlOpts {
    let mut opts: CurlOpts = curl_opts_default();
    let n: Int = list_len(args);
    let mut i: Int = 0;
    while i < n {
        let arg: String = list_get(args, i);
        if arg == "-h" || arg == "--help" {
            opts.help_mode = true;
            return opts;
        } else if arg == "-v" || arg == "--version" {
            opts.version_mode = true;
            return opts;
        } else if arg == "--mcp" {
            opts.mcp_mode = true;
        } else if arg == "-i" || arg == "--include" {
            opts.include_headers = true;
        } else if arg == "-I" || arg == "--head" {
            opts.head_only = true;
            opts.include_headers = true;
            if opts.method == "GET" { opts.method = "HEAD"; }
        } else if arg == "--no-color" {
            opts.no_color = true;
        } else if arg == "-s" || arg == "--silent" {
            opts.silent = true;
        } else if arg == "-X" || arg == "--request" {
            i = i + 1;
            if i < n { opts.method = str_to_upper(list_get(args, i)); }
        } else if str_starts_with(arg, "-X=") || str_starts_with(arg, "--request=") {
            let eq: Int = str_index_of(arg, "=");
            opts.method = str_to_upper(str_slice(arg, eq + 1, chars_len(arg)));
        } else if arg == "-H" || arg == "--header" {
            i = i + 1;
            if i < n { opts.headers = list_push(opts.headers, list_get(args, i)); }
        } else if str_starts_with(arg, "-H=") || str_starts_with(arg, "--header=") {
            let eq: Int = str_index_of(arg, "=");
            opts.headers = list_push(opts.headers, str_slice(arg, eq + 1, chars_len(arg)));
        } else if arg == "-d" || arg == "--data" {
            i = i + 1;
            if i < n {
                opts.data = list_get(args, i);
                if opts.method == "GET" { opts.method = "POST"; }
            }
        } else if str_starts_with(arg, "-d=") || str_starts_with(arg, "--data=") {
            let eq: Int = str_index_of(arg, "=");
            opts.data = str_slice(arg, eq + 1, chars_len(arg));
            if opts.method == "GET" { opts.method = "POST"; }
        } else if arg == "-o" || arg == "--output" {
            i = i + 1;
            if i < n { opts.output_file = list_get(args, i); }
        } else if str_starts_with(arg, "-o=") || str_starts_with(arg, "--output=") {
            let eq: Int = str_index_of(arg, "=");
            opts.output_file = str_slice(arg, eq + 1, chars_len(arg));
        } else if !str_starts_with(arg, "-") {
            opts.url = arg;
        }
        i = i + 1;
    }
    return opts;
}
